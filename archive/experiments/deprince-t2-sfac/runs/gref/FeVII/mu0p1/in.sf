SetAtom('Fe')
Config('g0', '1s2 2s2 2p6 3s2 3p6 3d2')
Config('ref', '1s2 2s2 2p6 3s2 3p5 3d3', '1s2 2s2 2p5 3s2 3p6 3d3', '1s1 2s2 2p6 3s2 3p6 3d3')
OptimizeRadial(['g0'])
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
SetOption('radial:hxs_iter0', 8)
PlasmaScreen(6.0, 1e-06, 0.020268607695987838, 1, 0.0, 1)
OptimizeRadial(['g0'])
PlasmaScreen(6.0, 1e-06, 0.0050671519239969594, 1, 0.0, 1)
OptimizeRadial(['g0'])
GetPotential('final.pot')
Structure('e.lev.b', ['g0', 'ref'])
MemENTable('e.lev.b')
PrintTable('e.lev.b', 'e.lev', 1)
