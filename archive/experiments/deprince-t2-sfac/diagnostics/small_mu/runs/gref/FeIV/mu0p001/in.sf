SetAtom('Fe')
Config('g0', '1s2 2s2 2p6 3s2 3p6 3d5')
Config('ref', '1s2 2s2 2p6 3s2 3p5 3d6', '1s2 2s2 2p5 3s2 3p6 3d6', '1s1 2s2 2p6 3s2 3p6 3d6')
OptimizeRadial(['g0'])
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
SetOption('radial:hxs_iter0', 8)
PlasmaScreen(3.0, 1e-06, 50.6715192399696, 1, 0.0, 1)
OptimizeRadial(['g0'])
GetPotential('final.pot')
Structure('e.lev.b', ['g0', 'ref'])
MemENTable('e.lev.b')
PrintTable('e.lev.b', 'e.lev', 1)
