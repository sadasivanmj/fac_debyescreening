SetAtom('Fe')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
SetOptimizePrint(1)
Config('g1', '1s2 2s2 2p6 3s2 3p6 3d6 4s1')
PlasmaScreen(1.0, 0.01, 50.6715192399696, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
GetPotential('g.pot')
Structure('g.lev.b', ['g1'])
MemENTable('g.lev.b')
PrintTable('g.lev.b', 'g.lev', 1)
