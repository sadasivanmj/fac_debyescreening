SetAtom('Fe')
SetOption('orbital:debye_emax_eps', 1e-2)
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1', '1s2 2s2 2p6 3s2 3p6 3d6 4s1')
PlasmaScreen(1.0, 1e-06, 0.0050671519239969594, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
Structure('g_n1e06.lev.b', ['g1'])
MemENTable('g_n1e06.lev.b')
PrintTable('g_n1e06.lev.b', 'g_n1e06.lev', 1)
