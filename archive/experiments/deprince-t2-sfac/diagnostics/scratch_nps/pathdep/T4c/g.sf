SetAtom('Fe')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1', '1s2 2s2 2p6 3s2 3p6 3d6 4s1')
OptimizeRadial(['g1'])
SetOption('radial:hxs_iter0', 4)
PlasmaScreen(1.0, 1e-06, 0.020268607695987838, 1, 0.0, 1)
OptimizeRadial(['g1'])
PlasmaScreen(1.0, 1e-06, 0.0050671519239969594, 1, 0.0, 1)
OptimizeRadial(['g1'])
PlasmaScreen(1.0, 1e-06, 0.0022520675217764267, 1, 0.0, 1)
OptimizeRadial(['g1'])
PlasmaScreen(1.0, 1e-06, 0.0012667879809992399, 1, 0.0, 1)
OptimizeRadial(['g1'])
PlasmaScreen(1.0, 1e-06, 0.0008107443078395134, 1, 0.0, 1)
OptimizeRadial(['g1'])
GetPotential('g.pot')
Structure('g.lev.b', ['g1'])
MemENTable('g.lev.b')
PrintTable('g.lev.b', 'g.lev', 1)
