SetAtom('Fe')
Config('g1', '1s2 2s2 2p6 3s2 3p6 3d6 4s1', '1s2 2s2 2p6 3s2 3p5 3d7 4s1')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
PlasmaScreen(1.0, 0.01, 50.6715192399696, 1, 0.0, 1)
OptimizeRadial(['g1'])
GetPotential('final.pot')
Structure('d.lev.b', ['g1'])
MemENTable('d.lev.b')
PrintTable('d.lev.b', 'd.lev', 1)
