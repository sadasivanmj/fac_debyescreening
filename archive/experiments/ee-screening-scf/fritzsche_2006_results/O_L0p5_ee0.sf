SetAtom('O')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 0)
Config('g1', '1s2 2s2')
Config('g2', '1s2 2s1 2p1')
Config('g3', '1s2 2p2')
PlasmaScreen(4.0, 0.01, 2.026860769598784, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1', 'g2'])
ConfigEnergy(1)
Structure('O_L0p5_ee0.lev.b', ['g1', 'g2', 'g3'])
MemENTable('O_L0p5_ee0.lev.b')
PrintTable('O_L0p5_ee0.lev.b', 'O_L0p5_ee0.lev', 1)
