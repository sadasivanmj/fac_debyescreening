SetAtom('C')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1', '1s2 2s2')
Config('g2', '1s2 2s1 2p1')
Config('g3', '1s2 2p2')
PlasmaScreen(2.0, 0.01, 12.6678798099924, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1', 'g2'])
ConfigEnergy(1)
Structure('C_L0p2_ee1.lev.b', ['g1', 'g2', 'g3'])
MemENTable('C_L0p2_ee1.lev.b')
PrintTable('C_L0p2_ee1.lev.b', 'C_L0p2_ee1.lev', 1)
