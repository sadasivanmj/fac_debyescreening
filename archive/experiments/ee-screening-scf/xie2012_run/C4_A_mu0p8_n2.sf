SetAtom('C')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 0)
Config('g1', '1s2')
Config('g2', '1s1 2*1')
Config('g_corr', '2*2')
PlasmaScreen(4.0, 0.01, 0.791742488124525, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
Structure('C4_A_mu0p8_n2.lev.b', ['g1', 'g2', 'g_corr'])
PrintTable('C4_A_mu0p8_n2.lev.b', 'C4_A_mu0p8_n2.lev', 1)
