SetAtom('Ar')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1','1s2')
Config('g2','1s1 2s1','1s1 2p1')
Config('g3','1s1 3s1','1s1 3p1','1s1 3d1')
PlasmaScreen(16, 0.01, 506715192399.7, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
GetPotential('Ar_ee1_L1e06.pot')
Structure('Ar_ee1_L1e06.lev.b',['g1','g2','g3'])
MemENTable('Ar_ee1_L1e06.lev.b')
PrintTable('Ar_ee1_L1e06.lev.b','Ar_ee1_L1e06.lev',1)
