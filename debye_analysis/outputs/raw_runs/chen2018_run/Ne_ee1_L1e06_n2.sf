SetAtom('Ne')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1','1s2')
Config('g2','1s1 2s1','1s1 2p1')
PlasmaScreen(8, 0.01, 506715192399.7, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
GetPotential('Ne_ee1_L1e06_n2.pot')
Structure('Ne_ee1_L1e06_n2.lev.b',['g1','g2'])
MemENTable('Ne_ee1_L1e06_n2.lev.b')
PrintTable('Ne_ee1_L1e06_n2.lev.b','Ne_ee1_L1e06_n2.lev',1)
