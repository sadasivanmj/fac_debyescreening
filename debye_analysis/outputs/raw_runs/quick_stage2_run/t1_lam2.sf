SetAtom('C')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 0)
Config('g1','1s2')
PlasmaScreen(4, 0.01, 506715192399.7, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
