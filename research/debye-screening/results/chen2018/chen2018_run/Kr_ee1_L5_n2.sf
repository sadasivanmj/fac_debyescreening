SetAtom('Kr')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1','1s2')
Config('g2','1s1 2s1','1s1 2p1')
PlasmaScreen(34, 0.01, 12.667879809992, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
GetPotential('Kr_ee1_L5_n2.pot')
Structure('Kr_ee1_L5_n2.lev.b',['g1','g2'])
MemENTable('Kr_ee1_L5_n2.lev.b')
PrintTable('Kr_ee1_L5_n2.lev.b','Kr_ee1_L5_n2.lev',1)
