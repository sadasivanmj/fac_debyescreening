SetAtom('Ne')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 0)
Config('g1','1s2')
Config('g2','1s1 2s1','1s1 2p1')
Config('g3','1s1 3s1','1s1 3p1','1s1 3d1')
PlasmaScreen(8, 0.01, 114.01091828993, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
GetPotential('Ne_ee0_L15.pot')
Structure('Ne_ee0_L15.lev.b',['g1','g2','g3'])
MemENTable('Ne_ee0_L15.lev.b')
PrintTable('Ne_ee0_L15.lev.b','Ne_ee0_L15.lev',1)
