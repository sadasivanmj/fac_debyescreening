SetAtom('C')
SetOption('orbital:debye_mode', 1)
SetOption('radial:ee_screen', 1)
Config('g1', '1s2')
Config('g2', '1s1 2*1')
Config('g3', '1s1 3*1')
Config('g4', '1s1 4*1')
Config('g_corr', '2*2', '2*1 3*1', '3*2')
PlasmaScreen(4.0, 0.01, 4.569571304635229, 1, 0.0, 1)
ConfigEnergy(0)
OptimizeRadial(['g1'])
ConfigEnergy(1)
Structure('C4_B_mu0p333_n4.lev.b', ['g1', 'g2', 'g3', 'g4', 'g_corr'])
PrintTable('C4_B_mu0p333_n4.lev.b', 'C4_B_mu0p333_n4.lev', 1)
