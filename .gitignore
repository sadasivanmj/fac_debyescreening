*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.out
*.toc
*.synctex.gz
*-converted-to.pdf
doc/*.log
doc/*/*.log

# manual (it should be pushed in release-pdf branch by circle-ci)
doc/manual.pdf

# ---- research repository additions ----
# macOS Finder metadata and generated Python packaging info
.DS_Store
PFAC.egg-info/
# local install prefix used with ./configure --prefix=$PWD/_noinstall (never installed)
_noinstall/

# Large FAC outputs inside copied result folders.  Summaries, manifests (json),
# CSV tables and logs (*.log is ignored above; add them with git add -f) are kept.
research/debye-screening/results/reference-configurations/reference_runs/**/levels.b
research/debye-screening/results/reference-configurations/reference_runs/**/levels.txt
research/debye-screening/results/reference-configurations/reference_runs/**/final.pot
research/full-active-space/results/**/*.b
research/full-active-space/results/**/*.pot
research/full-active-space/results/**/*.bpt
research/full-active-space/results/**/*.wav
research/full-active-space/results/**/e.lev

# Publisher PDF of the reference paper: kept locally, see references/README.md
research/debye-screening/references/*.pdf
# binary FAC failure dumps (the text error.pot next to them is kept)
research/**/error.bpt
research/**/error.wav
archive/**/error.bpt
archive/**/error.wav
# ... except these two small failure dumps, which are tracked: error.bpt can be
# reloaded with fac.RestorePotential to reproduce the failing potential
!research/debye-screening/results/c4/c4_ground_results/error.bpt
!research/debye-screening/results/c4/c4_ground_results/error.wav
!archive/experiments/early-fe-calculations/fe_ip_sfac_runs/FeII_mu0p1/error.bpt
!archive/experiments/early-fe-calculations/fe_ip_sfac_runs/FeII_mu0p1/error.wav

# gfortran module file generated by compiling faclib/f2c.f90 (was committed by accident)
/faclib/f2c.mod

# Regenerable FAC run products of the Fe research runs (checked: no tracked final.pot/levels.b under research/fe-*).
# Deliberately NOT a repo-wide *.pot/*.b/*.lev rule: ~1500 archived result files of that type are tracked.
research/fe-ii-viii-reference-ip/results/*/runs/**/final.pot
research/fe-ii-viii-reference-ip/results/*/runs/**/levels.b
research/fe-xvii-xxv-ground-ip/results/*/runs/**/final.pot
research/fe-xvii-xxv-ground-ip/results/*/runs/**/levels.b

# calculate_ip_fe_ii.py output (regenerable with the script)
/fe_calc/fe_energy/
